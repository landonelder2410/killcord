# ─── Proxy upstreams ───────────────────────────────────────────────────────────
# Full base URL for each provider. Killcord routes /v1/messages → Anthropic,
# /v1/chat/completions → OpenAI. Override to point at a gateway or local mock.
ANTHROPIC_UPSTREAM=https://api.anthropic.com
OPENAI_UPSTREAM=https://api.openai.com

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=8080
WORKERS=2                    # cluster worker count; defaults to CPU count
TRUST_PROXY=                 # '1' for ALB/Nginx single-hop; 'loopback' for localhost
BODY_LIMIT=2mb               # max incoming JSON body size (e.g. 2mb, 10mb)

# ─── CORS (browser requests only — agent SDK calls skip this) ──────────────────
# Comma-separated origin list. When unset defaults to localhost:3000/8080 only.
ALLOWED_ORIGINS=

# ─── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=changeme        # guards /health, /roi, /metrics

# ─── License key enforcement ───────────────────────────────────────────────────
KILLCORD_REQUIRE_LICENSE_KEY=true   # set to 'false' for dev/single-worker mode

# ─── Global rate limit (all routes) ────────────────────────────────────────────
RATE_LIMIT_MAX=1000          # max requests per window per IP
RATE_LIMIT_WINDOW=60000      # window size in milliseconds

# ─── Proxy-specific rate limit (/v1/messages and /v1/chat/completions) ─────────
KILLCORD_PROXY_RATE_LIMIT_MAX=60   # tighter cap for proxy endpoints

# ─── Circuit breaker ───────────────────────────────────────────────────────────
CB_WINDOW_MS=60000           # tracking window in milliseconds
CB_TOOL_REPEAT_LIMIT=5       # max identical tool calls before trip (stateless, per-request)
CB_TOKEN_BURST_LIMIT=50000   # max estimated tokens per window per session
CB_REQUEST_LIMIT=30          # max requests per window per session

# ─── Redis (in-memory fallback used when unset) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Trace capture ─────────────────────────────────────────────────────────────
KILLCORD_TRACE_ENABLED=true                    # set to 'false' to disable
KILLCORD_TRACE_DIR=./.killcord/traces          # JSONL trace output directory
KILLCORD_TRACE_RETENTION_DAYS=7                # days before trace files are deleted

# ─── Webhook alerts (optional) ─────────────────────────────────────────────────
# Receives a POST with JSON payload whenever the circuit breaker trips.
WEBHOOK_URL=

# ─── ROI pricing (used by /roi endpoint only) ──────────────────────────────────
CLAUDE_PRICE_PER_MTOK=3.00   # USD per million input tokens
OPENAI_PRICE_PER_MTOK=2.50   # USD per million input tokens

# ─── Replay viewer (replay/ sub-package) ───────────────────────────────────────
AGENT_REPLAY_PORT=3030

# ─── Billing (only needed when KILLCORD_BILLING_ENABLED=true) ──────────────────
# When disabled, all /api/billing/checkout requests return 503.
KILLCORD_BILLING_ENABLED=false

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Core tier price IDs — set in Stripe dashboard, copy the price_... ID here
STRIPE_PRICE_ID_DEVELOPER=price_...
STRIPE_PRICE_ID_GROWTH=price_...
STRIPE_PRICE_ID_SCALE=price_...

# Optional: legacy single-price fallback
STRIPE_PRICE_ID=

# Optional: allowlist of additional price IDs accepted by /checkout
STRIPE_ALLOWED_PRICE_IDS=

# Add-on price IDs (used by web/app/api/checkout/route.ts)
STRIPE_PRICE_ID_ADDON_REPLAY_PRO=price_...
STRIPE_PRICE_ID_ADDON_REPLAY_PRO_ONESHOT=price_...
STRIPE_PRICE_ID_ADDON_STORAGE_PACK=price_...

# URLs for the proxy billing router (src/billing.ts)
STRIPE_SUCCESS_URL=http://localhost:3001/success
STRIPE_CANCEL_URL=http://localhost:3001/#pricing
