# ─── Core ──────────────────────────────────────────────────────────────────────
# Target LLM API (Anthropic, OpenAI, or any compatible endpoint)
UPSTREAM_API_URL=https://api.anthropic.com

# Admin key for /health, /metrics, /roi endpoints
ADMIN_API_KEY=changeme

# ─── Worker config ─────────────────────────────────────────────────────────────
# Number of cluster workers (default: CPU count)
WORKERS=2

# Port the proxy listens on (default: 3000)
PORT=3000

# ─── Feature flags ─────────────────────────────────────────────────────────────
# Require every request to carry a valid x-killcord-key header
KILLCORD_REQUIRE_LICENSE_KEY=true

# Enable per-request JSONL trace files in .killcord/traces/
KILLCORD_TRACE_ENABLED=false

# Enable semantic loop detection (requires MiniLM embedder)
KILLCORD_SEMANTIC_LOOP_ENABLED=true

# Enable Stripe billing integration (disabled by default)
KILLCORD_BILLING_ENABLED=false

# ─── Loop detection ────────────────────────────────────────────────────────────
# Max identical (exact-match) consecutive requests before 429
KILLCORD_LOOP_LIMIT=5

# Cosine-similarity threshold for semantic loop detection (0–1)
KILLCORD_SEMANTIC_THRESHOLD=0.94

# Number of prior turns inspected for semantic similarity
KILLCORD_SEMANTIC_WINDOW=5

# Consecutive semantically-similar turns required to trip the breaker
KILLCORD_SEMANTIC_REPEATS=3

# ─── Rate limiting ─────────────────────────────────────────────────────────────
# Max requests per window per IP/key
KILLCORD_PROXY_RATE_LIMIT_MAX=60

# Window size in seconds
KILLCORD_PROXY_RATE_LIMIT_WINDOW=60

# ─── Redis (optional — in-memory fallback used when not set) ───────────────────
REDIS_URL=redis://localhost:6379

# ─── Billing (only needed when KILLCORD_BILLING_ENABLED=true) ──────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_HACKER=price_...
STRIPE_PRICE_DEV=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...
KILLCORD_SUCCESS_URL=http://localhost:3001/success
KILLCORD_CANCEL_URL=http://localhost:3001/#pricing
