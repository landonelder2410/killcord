{
  "name": "agent-replay",
  "version": "0.1.0",
  "description": "CLI tool and local web viewer for replaying AI agent traces",
  "main": "dist/cli.js",
  "bin": {
    "agent-replay": "./bin/agent-replay.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
