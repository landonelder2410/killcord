  "keywords": ["ai", "agent", "replay", "trace", "debug"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
