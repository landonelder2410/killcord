{
  "name": "killcord",
  "version": "0.1.2",
  "description": "Semantic circuit breaker that stops runaway AI agent loops before they burn your API budget",
  "main": "dist/index.js",
  "bin": {
    "killcord": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:single": "WORKERS=1 KILLCORD_REQUIRE_LICENSE_KEY=false tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test:proxy": "node scripts/test-loop-breaker.mjs --managed"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "proxy",
    "llm",
    "tools",
    "semantic-search",
    "vector"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "stripe": "^22.3.2",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/node": "^20.14.0",
    "autocannon": "^7.15.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
